{
  "name": "press",
  "private": true,
  "version": "2.3.0",
  "type": "module",
  "scripts": {
    "preinstall": "([ -e $HOME/.nvm/nvm.sh ] && . $HOME/.nvm/nvm.sh && nvm install && nvm use) || true",
    "dev": ". $HOME/.nvm/nvm.sh && nvm use && vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "deploy": "scripts/build.sh",
    "sync:cloudinary": "node scripts/cloudinary.js"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.0",
    "@eslint/js": "^9.37.0",
    "@fontsource/fira-mono": "^5.2.7",
    "@neoconfetti/svelte": "^2.2.2",
    "@sveltejs/adapter-node": "^5.3.3",
    "@sveltejs/kit": "^2.46.5",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@tailwindcss/typography": "^0.5.19",
    "@types/js-cookie": "^3.0.6",
    "@types/luxon": "^3.7.1",
    "@types/mailchimp__mailchimp_transactional": "^1.0.11",
    "@types/node": "^24.7.2",
    "autoprefixer": "^10.4.21",
    "cloudinary": "^2.7.0",
    "daisyui": "^5.3.1",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.12.4",
    "globals": "^16.4.0",
    "lucide-svelte": "^0.545.0",
    "maplibre-gl": "^5.9.0",
    "msw": "^2.11.5",
    "ora": "^9.0.0",
    "postcss": "^8.5.6",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sass": "^1.93.2",
    "svelte": "^5.39.12",
    "svelte-check": "^4.3.3",
    "svelte-maplibre-gl": "^1.0.1",
    "sveltekit-flash-message": "^2.4.6",
    "sveltekit-superforms": "^2.27.3",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.1.9",
    "zod": "^4.1.12"
  },
  "dependencies": {
    "@botpoison/browser": "^0.1.30",
    "@botpoison/node": "^0.1.10",
    "@mailchimp/mailchimp_transactional": "^1.0.59",
    "@sveltejs/adapter-vercel": "^5.10.3",
    "@tailwindcss/vite": "^4.1.14",
    "dotenv": "^17.2.3",
    "embla-carousel": "^8.6.0",
    "embla-carousel-svelte": "^8.6.0",
    "i18n-iso-countries": "^7.14.0",
    "js-cookie": "^3.0.5",
    "luxon": "^3.7.2",
    "svelte-device-info": "^1.0.6",
    "sveltekit-i18n": "^2.4.2",
    "swiper": "^12.0.2",
    "tailwind-merge": "^3.3.1"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@tailwindcss/oxide"
  ]
