{
  "name": "press",
  "private": true,
  "version": "2.10.0",
  "type": "module",
  "scripts": {
    "preinstall": "([ -e $HOME/.nvm/nvm.sh ] && . $HOME/.nvm/nvm.sh && nvm install && nvm use) || true",
    "dev": ". $HOME/.nvm/nvm.sh && nvm use && vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write ./src",
    "lint": "prettier --check . && eslint .",
    "deploy": "scripts/build.sh",
    "sync:cloudinary": "node scripts/cloudinary.js",
    "sync:article-mocks": "node scripts/sync-article-mocks.js",
    "test": "vitest"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^9.39.2",
    "@fontsource/fira-mono": "^5.2.7",
    "@neoconfetti/svelte": "^2.2.2",
    "@sveltejs/kit": "^2.62.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/js-cookie": "^3.0.6",
    "@types/luxon": "^3.7.1",
    "@types/mailchimp__mailchimp_transactional": "^1.0.12",
    "@types/node": "^25.9.1",
    "autoprefixer": "^10.5.0",
    "cloudinary": "^2.10.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "ora": "^9.4.0",
    "postcss": "^8.5.15",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.8",
    "prettier-plugin-svelte": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "sass": "^1.100.0",
    "svelte": "^5.56",
    "svelte-check": "^4.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^7.3.1",
    "vitest": "^4.1.8",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@botpoison/browser": "^0.1.30",
    "@botpoison/node": "^0.1.10",
    "@mailchimp/mailchimp_transactional": "^1.4",
    "@sveltejs/adapter-node": "^5.5",
    "@sveltejs/adapter-vercel": "^6.3",
    "@tailwindcss/vite": "^4.3",
    "@types/nodemailer": "^8.0.0",
    "daisyui": "^5.5.20",
    "dotenv": "^17.4.2",
    "embla-carousel": "^8.6.0",
    "embla-carousel-svelte": "^8.6.0",
    "i18n-iso-countries": "^7.14.0",
    "js-cookie": "^3.0.8",
    "@lucide/svelte": "^1.17.0",
    "luxon": "^3.7.2",
    "maplibre-gl": "^5.24.0",
    "nodemailer": "^8.0.10",
    "svelte-device-info": "^1.0.6",
    "svelte-maplibre-gl": "^2.0.1",
    "sveltekit-flash-message": "^2.4.6",
