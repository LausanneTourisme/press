{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:lang(fr|en|de)/:section(articles|artikeln)/:id(\\d+)/:slug",
      "destination": "/:lang/:section/:slug",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/:lang(fr|en|de)/:section(communiques-de-presse-et-dossier-de-presse|press-releases-and-press-kits|pressemitteilungen-und-pressedossier)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=3600"
        }
      ]
    },
    {
      "source": "/:lang(fr|en|de)/:section(themes|themen)/:theme",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=3600"
        }
      ]
    }
  ]
}
